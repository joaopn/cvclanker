# =============================================================================
# CV Clanker - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

MODEL=google/gemini-3-flash-preview

# Optional: Authentication for protected app and API access
# The app is fully unauthenticated if this isn't set, which is the default.
# Both values can also be managed from the Settings UI (stored in the DB).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional override of the JWT session-signing secret (at least 32 characters).
# If omitted, CV Clanker manages one in the database (runtime_secrets), so a DB
# snapshot restore keeps sessions working. Set this only to pin the secret
# externally; the env value wins over the DB one.
# JWT_SECRET=

# Optional baseline for JWT session expiry in seconds (default: 86400 = 24h).
# The "Session expiry" value in the Settings UI overrides this.
# JWT_EXPIRY_SECONDS=86400

# Optional baseline ceiling on ONE LLM request, in milliseconds (default:
# 300000 = 5 minutes). It exists so a provider that accepts a request and then
# stalls cannot hold a pipeline run open forever. The "LLM request timeout"
# value in Settings -> Pipeline Behavior overrides this; the per-provider
# timeouts below still win for their own provider.
# LLM_REQUEST_TIMEOUT_MS=300000

# Optional baseline ceiling on ONE tectonic run, in milliseconds (default:
# 600000 = 10 minutes). Bounds every LaTeX compile: the gated CV and cover
# letter uploads, the per-job renders, and the previews. The first compile on
# a fresh container also downloads the LaTeX packages the document pulls in,
# so it is far slower than every one after it. The "LaTeX compile timeout"
# value in Settings -> Pipeline Behavior overrides this.
# LATEX_COMPILE_TIMEOUT_MS=600000

# =============================================================================
# Claude Code provider (LLM_PROVIDER=claude_code)
# =============================================================================
# Every LLM query is run as a headless `claude -p` process. Mint a long-lived
# token with `claude setup-token` (needs a Claude subscription) and set it here,
# or paste it into the "Claude Code OAuth token" field in Settings — a saved
# value overrides this baseline. It has its own setting rather than sharing the
# LLM API key field, so a key left over from another provider can never shadow it.
# CLAUDE_CODE_OAUTH_TOKEN=

#
# Each query runs isolated: the CLI gets a minimal allowlisted environment (no
# other server secrets), a throwaway working dir and HOME, and its telemetry,
# error reporting, and auto-updater are disabled — it can only call the model.
#
# Optional overrides:
# CLAUDE_CODE_BIN=claude
# CLAUDE_CODE_REQUEST_TIMEOUT_MS=120000
# CLAUDE_CODE_AUTH_TIMEOUT_MS=15000
#
# Reasoning effort passed as `--effort` on every call (low, medium, high,
# xhigh, max). Unset uses the CLI default; the Settings UI value overrides.
# CLAUDE_CODE_EFFORT=
#
# Timeouts for the Settings CLI panel (version probe / registry check / update):
# CLAUDE_CODE_PROBE_TIMEOUT_MS=15000
# CLAUDE_CODE_REGISTRY_TIMEOUT_MS=10000
# CLAUDE_CODE_INSTALL_TIMEOUT_MS=300000

# =============================================================================
# JobSpy - Job search configuration
# =============================================================================
# Filter for remote-only jobs (default: 0 = disabled)
# JOBSPY_IS_REMOTE=0
